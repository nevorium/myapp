# .env.example
# ==============================================================================
# Panduan Kredensial & Konfigurasi Proyek Flutter (Murojaah MVP)
# ==============================================================================

# CATATAN PENTING:
# Proyek Flutter ini TIDAK menggunakan file `.env` secara langsung untuk mengelola
# kredensial Firebase. Arsitektur proyek mengandalkan mekanisme resmi Firebase
# untuk koneksi.

# ------------------------------------------------------------------------------
# 💡 Bagaimana Proyek Ini Mengelola Kredensial Firebase?
# ------------------------------------------------------------------------------
# Aplikasi Murojaah MVP terintegrasi erat dengan Firebase untuk:
# - Autentikasi Pengguna (Firebase Authentication)
# - Database (Cloud Firestore)
# - Notifikasi (melalui layanan notifikasi lokal yang dapat menggunakan data dari Firestore)

# Kredensial Firebase (seperti API key, Project ID, App ID, dll.) untuk setiap
# platform (Android, iOS, Web) DIHASILKAN secara otomatis ke dalam file:
# `lib/firebase_options.dart`.

# File ini adalah satu-satunya sumber kebenaran (Single Source of Truth) untuk
# konfigurasi Firebase Anda di sisi klien Flutter. Anda TIDAK perlu menyalin
# kredensial ini secara manual ke file `.env` atau ke dalam kode Flutter lainnya.

# ------------------------------------------------------------------------------
# 🚀 Tutorial: Cara Menyambungkan Kredensial Firebase dengan Proyek Anda
# ------------------------------------------------------------------------------

# Untuk mengaktifkan koneksi Firebase dan menghasilkan `lib/firebase_options.dart`,
# ikuti langkah-langkah berikut:

# PRASYARAT:
# 1. Pastikan Anda telah menginstal Flutter SDK: https://flutter.dev/docs/get-started/install
# 2. Pastikan Anda telah menginstal Node.js dan npm/yarn.
# 3. Instal Firebase CLI secara global jika belum:
#    npm install -g firebase-tools

# LANGKAH-LANGKAH KONEKSI:

# 1. Buat atau Pilih Proyek Firebase Anda:
#    ➡️ Kunjungi Firebase Console: https://console.firebase.google.com/
#    ➡️ Buat proyek baru atau pilih proyek Firebase yang sudah ada yang ingin Anda gunakan.
#       Catat Project ID Anda (misalnya: `your-project-id-12345`).

# 2. Login ke Firebase CLI:
#    Buka terminal (di lingkungan pengembangan Anda) dan jalankan:
#    firebase login
#    Ikuti instruksi untuk login menggunakan akun Google Anda yang terhubung dengan proyek Firebase.

# 3. Konfigurasi Proyek Flutter dengan Firebase:
#    Navigasi ke root direktori proyek Flutter Anda (tempat file `pubspec.yaml` berada).
#    Kemudian, jalankan perintah berikut:
#    flutterfire configure

#    Perintah ini akan memandu Anda melalui proses konfigurasi:
#    - Memilih proyek Firebase yang ingin Anda hubungkan.
#    - Memilih platform (Android, iOS, Web) yang ingin Anda dukung.
#    - Secara otomatis menghasilkan file `lib/firebase_options.dart`.
#    - Secara otomatis menambahkan file konfigurasi khusus platform (misalnya,
#      `google-services.json` untuk Android, `GoogleService-Info.plist` untuk iOS).

#    CONTOH OUTPUT `firebase_options.dart` (isi akan bervariasi):
#    ```dart
#    // lib/firebase_options.dart
#    import 'package:firebase_core/firebase_core.dart' show FirebaseOptions;
#    import 'package:flutter/foundation.dart'
#        show defaultTargetPlatform, kIsWeb, TargetPlatform;
#
#    class DefaultFirebaseOptions {
#      static FirebaseOptions get currentPlatform {
#        if (kIsWeb) {
#          return web;
#        }
#        switch (defaultTargetPlatform) {
#          case TargetPlatform.android:
#            return android;
#          case TargetPlatform.iOS:
#            return ios;
#          case TargetPlatform.macOS:
#            throw UnsupportedError(
#                'DefaultFirebaseOptions have not been configured for macos - ' 
#                'you can reconfigure this by running the FlutterFire CLI again.'
#            );
#          case TargetPlatform.windows:
#            throw UnsupportedError(
#                'DefaultFirebaseOptions have not been configured for windows - ' 
#                'you can reconfigure this by running the FlutterFire CLI again.'
#            );
#          case TargetPlatform.linux:
#            throw UnsupportedError(
#                'DefaultFirebaseOptions have not been configured for linux - ' 
#                'you can reconfigure this by running the FlutterFire CLI again.'
#            );
#          default:
#            throw UnsupportedError(
#                'DefaultFirebaseOptions are not supported for this platform.'
#            );
#        }
#      }
#
#      static const FirebaseOptions web = FirebaseOptions(
#        apiKey: 'YOUR_WEB_API_KEY',
#        appId: 'YOUR_WEB_APP_ID',
#        messagingSenderId: 'YOUR_MESSAGING_SENDER_ID',
#        projectId: 'your-project-id',
#        authDomain: 'your-project-id.firebaseapp.com',
#        databaseURL: 'https://your-project-id-default-rtdb.firebaseio.com',
#        storageBucket: 'your-project-id.appspot.com',
#      );
#
#      static const FirebaseOptions android = FirebaseOptions(
#        apiKey: 'YOUR_ANDROID_API_KEY',
#        appId: 'YOUR_ANDROID_APP_ID',
#        messagingSenderId: 'YOUR_MESSAGING_SENDER_ID',
#        projectId: 'your-project-id',
#        databaseURL: 'https://your-project-id-default-rtdb.firebaseio.com',
#        storageBucket: 'your-project-id.appspot.com',
#      );
#
#      static const FirebaseOptions ios = FirebaseOptions(
#        apiKey: 'YOUR_IOS_API_KEY',
#        appId: 'YOUR_IOS_APP_ID',
#        messagingSenderId: 'YOUR_MESSAGING_SENDER_ID',
#        projectId: 'your-project-id',
#        databaseURL: 'https://your-project-id-default-rtdb.firebaseio.com',
#        storageBucket: 'your-project-id.appspot.com',
#        bundleId: 'com.example.myapp',
#      );
#    }
#    ```

# ------------------------------------------------------------------------------
# 🌍 Kredensial API Eksternal Lainnya (Opsional - Jika Diperlukan di Masa Depan)
# ------------------------------------------------------------------------------

# Saat ini, API jadwal sholat (aladhan.com) yang digunakan di proyek ini
# tidak memerlukan API key untuk fungsionalitas dasarnya.

# Jika di masa mendatang Anda mengintegrasikan API pihak ketiga lainnya
# yang memerlukan kunci (API Key), Anda dapat menyimpannya di file `.env`
# (yang TIDAK DIKOMIT ke Git) dan mengaksesnya di kode Flutter Anda.

# Jika Anda memilih untuk menggunakan `.env` untuk API eksternal:
# 1. Buat file `.env` di root proyek Anda (misalnya, di sebelah `pubspec.yaml`).
# 2. Tambahkan `.env` ke file `.gitignore` Anda.
# 3. Masukkan kredensial Anda dalam format `KEY=VALUE`.
#
#    CONTOH `.env` (JANGAN KOMIT INI KE GIT):
#    ```
#    GOOGLE_MAPS_API_KEY="AIzaSyC...your_api_key..."
#    WEATHER_API_KEY="your_weather_api_key"
#    ```
#
# 4. Untuk mengaksesnya di Flutter, Anda perlu menggunakan *package* seperti
#    `flutter_dotenv` (tambahkan ke `pubspec.yaml`):
#    flutter pub add flutter_dotenv
#
# 5. Lalu, inisialisasi dan baca di kode Anda (misalnya, di `main.dart`):
#    ```dart
#    import 'package:flutter_dotenv/flutter_dotenv.dart';
#    void main() async {
#      await dotenv.load(fileName: ".env");
#      runApp(MyApp());
#    }
#    // Mengakses nilai:
#    String? apiKey = dotenv.env['GOOGLE_MAPS_API_KEY'];
#    ```

